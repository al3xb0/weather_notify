# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://weather:weather@localhost:5432/weather_notify?schema=public"

# ── Auth (JWT) ────────────────────────────────────────────
# Secrets must be >= 32 chars and not start with "change-me" (validated at boot).
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_TTL="7d"
# Refresh-cookie SameSite. Use "lax" when the API and UI share a site; use
# "none" (requires HTTPS) when the frontend is on a different domain (e.g. Vercel).
COOKIE_SAMESITE="lax"

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_URL="amqp://weather:weather@localhost:5672"
RABBITMQ_EXCHANGE="notifications"

# ── Compose infrastructure credentials ────────────────────
# Consumed by docker-compose.yml for Postgres and RabbitMQ, and by the
# DATABASE_URL/RABBITMQ_URL it builds for the services. Change them before any
# deployment that is not a laptop.
#
# Postgres reads these once, when it initialises an empty volume. Editing
# POSTGRES_PASSWORD afterwards changes what the clients send, not what the
# database expects, and every service then fails with P1000. To rotate it on a
# volume that already exists:
#   docker compose exec postgres psql -U weather -d weather_notify \
#     -c "ALTER USER weather WITH PASSWORD 'new'"
# `docker compose down -v` is the other way out, and it deletes the data.
# Avoid @ : / ? # % in the password — these values are interpolated into
# DATABASE_URL, where those characters are URL syntax.
POSTGRES_USER="weather"
POSTGRES_PASSWORD="weather"
POSTGRES_DB="weather_notify"
RABBITMQ_USER="weather"
RABBITMQ_PASSWORD="weather"

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# Keep this below WATCHER_CRON's interval. A snapshot that outlives the interval
# is served back to the next cycle, which then re-decides on data it has already
# acted upon — half the cycles cost writes and can never change their mind.
WEATHER_CACHE_TTL_SEC=240

# ── Watcher ───────────────────────────────────────────────
# Cron expression for the polling cycle (default: every 5 minutes)
WATCHER_CRON="0 */5 * * * *"
# How many staged events one outbox relay pass hands to the broker.
OUTBOX_BATCH_SIZE=200

# ── Notification channels ─────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# SMTP mailer — works with any free provider (Gmail, Brevo, Mailtrap, …).
# Leave SMTP_HOST empty to disable email (verification links are logged instead).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="alerts@example.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@example.com"

# ── Notifier retry/DLQ ────────────────────────────────────
# One retry queue per comma-separated delay (ms), tried in order. Total attempts
# = stages + 1; after the last one the message is parked in <queue>.dead.
NOTIFIER_RETRY_DELAYS_MS=5000,30000,300000
NOTIFIER_PREFETCH=10

# ── App ───────────────────────────────────────────────────
NODE_ENV="development"
CORE_API_PORT=3000
# Comma-separated allow-list of front-end origins (no wildcard reflection).
CORS_ORIGIN="http://localhost:3001"
# Number of reverse proxies in front of the API (1 for the Caddy setup in
# docker-compose). Leave empty when the API is reached directly: trusting a
# proxy that is not there lets a client spoof its IP via X-Forwarded-For and
# walk around the rate limiter.
TRUST_PROXY=
# Days of delivery history to keep. The sweep runs nightly; history is
# append-only, so without it the table grows with uptime rather than with usage.
NOTIFICATION_RETENTION_DAYS=90
# Public URL of the frontend — used to build email verification links.
FRONT_URL="http://localhost:3001"

# ── Database backups ──────────────────────────────────────
# The db-backup service dumps Postgres on this interval, verifies the archive is
# readable, and prunes copies older than the retention window.
BACKUP_INTERVAL_SEC=86400
BACKUP_RETENTION_DAYS=14
# Leave the bucket empty for local-only dumps — which survive a dropped table
# but not a lost VM. Set it, with the credentials below, to make this a real
# disaster-recovery plan. Works with any S3-compatible store (Backblaze B2,
# Cloudflare R2, MinIO) by also setting AWS_ENDPOINT_URL.
BACKUP_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION=""
AWS_ENDPOINT_URL=""

# ── Monitoring ────────────────────────────────────────────
# Grafana sits on 127.0.0.1:3005 and Prometheus on 127.0.0.1:9090 — reach them
# over an SSH tunnel rather than publishing them. Change these before the stack
# goes anywhere real.
GRAFANA_USER="admin"
GRAFANA_PASSWORD="admin"
