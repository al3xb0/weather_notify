              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "telegramChatId": {
            "type": "string",
            "nullable": true
          },
          "telegramLinked": {
            "type": "boolean"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "quietHoursStart": {
            "type": "string",
            "nullable": true,
            "example": "22:00"
          },
          "quietHoursEnd": {
            "type": "string",
            "nullable": true,
            "example": "07:00"
          },
          "timezone": {
            "type": "string",
            "nullable": true,
            "example": "Europe/Berlin"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
