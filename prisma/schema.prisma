generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Metric {
  TEMPERATURE
  APPARENT_TEMP
  WIND_SPEED
  PRECIPITATION
  HUMIDITY
  SEVERE
}

enum Operator {
  GT
  GTE
  LT
  LTE
  EQ
}

enum Channel {
  TELEGRAM
  EMAIL
  WEB_PUSH
}

enum TriggerState {
  ARMED
  FIRED
}

enum ConditionLogic {
  AND
  OR
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
}

enum Role {
  USER
  ADMIN
}

model User {
  id                              String             @id @default(uuid())
  email                           String             @unique
  passwordHash                    String
  role                            Role               @default(USER)
  telegramChatId                  String?
  telegramLinkToken               String?            @unique
  telegramLinkTokenExpiresAt      DateTime?
  quietHoursStart                 String?
  quietHoursEnd                   String?
  timezone                        String?
  emailVerified                   Boolean            @default(false)
  emailVerificationToken          String?            @unique
  emailVerificationTokenExpiresAt DateTime?
  triggers                        Trigger[]
  pushSubs                        PushSubscription[]
  notifications                   Notification[]
  refreshTokens                   RefreshToken[]
  pinnedCities                    PinnedCity[]
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt
}

model Trigger {
  id              String             @id @default(uuid())
  userId          String
  name            String
  city            String
  latitude        Float
  longitude       Float
  conditionLogic  ConditionLogic     @default(AND)
  conditions      TriggerCondition[]
  notifications   Notification[]
  channels        Channel[]
  cooldownMin     Int                @default(60)
  isActive        Boolean            @default(true)
  state           TriggerState       @default(ARMED)
  lastFiredAt     DateTime?
  lastEvaluatedAt DateTime?
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([isActive, latitude, longitude])
  @@index([userId])
}

model TriggerCondition {
  id                String   @id @default(uuid())
  triggerId         String
  metric            Metric
  operator          Operator
  threshold         Float
  order             Int      @default(0)
  lastObservedValue Float?
  lastMatched       Boolean?
  trigger           Trigger  @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@index([triggerId])
}

model Notification {
  id        String      @id @default(uuid())
  /// Id of the TriggerFiredEvent this row was claimed for. Null only for rows
  /// written before delivery became idempotent.
  eventId   String?
  triggerId String?
  userId    String
  channel   Channel
  status    NotifStatus
  payload   Json
  error     String?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger   Trigger?    @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  /// The claim that makes at-least-once delivery safe: one row per event and
  /// channel, so a redelivered message finds the existing row instead of
  /// sending twice.
  @@unique([eventId, channel])
  @@index([userId, createdAt])
  @@index([triggerId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Events written in the same transaction as the state change that produced
/// them, then relayed to the broker. Without it a crash between "published" and
/// "marked as fired" re-fires the trigger with a fresh eventId, which the
/// consumer's (eventId, channel) claim cannot recognise as a duplicate.
model OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String
  routingKey  String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  /// One row per event and routing key, so a retried commit cannot enqueue the
  /// same delivery twice.
  @@unique([eventId, routingKey])
  /// Drives the relay's "oldest unpublished first" scan.
  @@index([publishedAt, createdAt])
}

model PinnedCity {
  id        String   @id @default(uuid())
  userId    String
  name      String
  country   String?
  admin1    String?
  latitude  Float
  longitude Float
  order     Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, latitude, longitude])
  @@index([userId])
}
